# METATRON Docker configuration
# Copy to .env and edit as needed: cp .env.example .env

# MariaDB — IMPORTANT: Change these passwords before any real use
MARIADB_ROOT_PASSWORD=change_me_before_deploy
METATRON_DB_USER=metatron
METATRON_DB_PASS=change_me_before_deploy
METATRON_DB_NAME=metatron

# Ollama (no changes needed unless using remote Ollama)
# OLLAMA_URL=http://ollama:11434/api/generate
# OLLAMA_MODEL=metatron-qwen
